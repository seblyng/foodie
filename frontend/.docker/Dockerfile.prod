FROM rust:1.94.1-bookworm AS builder
ARG CARGO_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends clang lld \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install trunk --version 0.21.14 --locked

COPY common/Cargo.toml common/Cargo.lock /common/
COPY common/src /common/src
COPY frontend/rust-toolchain.toml ./
RUN rustup toolchain install nightly-2025-08-01 --profile minimal \
    --target wasm32-unknown-unknown
COPY frontend/Cargo.toml frontend/Cargo.lock frontend/Trunk.toml frontend/index.html frontend/input.css ./
COPY frontend/public ./public
COPY frontend/img ./img
COPY frontend/src ./src
ENV RUSTFLAGS='--cfg getrandom_backend="wasm_js"'
RUN trunk build --release --locked

FROM caddy:2.10.2-alpine AS runtime
ARG CADDYFILE=.docker/Caddyfile
# Kubernetes listens on 8080 and drops all capabilities. The upstream file
# capability would otherwise make exec fail with EPERM under that bounding set.
RUN setcap -r /usr/bin/caddy
COPY --from=builder /app/dist /srv
COPY ${CADDYFILE} /etc/caddy/Caddyfile
EXPOSE 80 8080
